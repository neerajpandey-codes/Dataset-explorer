# Local environment and credentials. Keep only the sanitized template in Git.
.env
.env.*
!.env.example

# Dependencies and generated build/cache output.
node_modules/
dist/
.vite/
*.tsbuildinfo
coverage/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local credentials, certificates, and secret material.
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*-service-account.json
**/credentials/
**/secrets/
**/*credentials*
**/*secret*

# OS/editor noise.
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
